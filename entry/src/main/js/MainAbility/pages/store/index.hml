<!-- 应用市场页：vList 应用列表 / vDetail 应用详情 / vOrd 订单列表 / vOdD 订单详情 -->
<stack class="root" style="width: {{screenW}};height: {{screenH}};">
  <image class="s-bg" src="/common/wall/bing.png" style="width: {{screenW}};height: {{screenH}};top: 0px;left: 0px;"></image>
  <div class="s-mask" style="width: {{screenW}};height: {{screenH}};top: 0px;left: 0px;"></div>

  <!-- ── 应用列表（横向滑动，6 槽翻页） ── -->
  <div class="panel" if="{{vList}}" style="width: {{screenW}};height: {{screenH}};">
    <text class="p-title">更多应用</text>
    <text class="p-page">{{listPageText}}</text>
    <swiper class="lswiper" index="{{listSwiperIdx}}" loop="false" indicator="false" onchange="onListChange">
      <div class="lcard" onclick="cardTap0">
        <text class="l-name">{{l1n}}</text>
        <text class="l-dev">{{l1d}}</text>
        <text class="l-pts">{{l1p}}</text>
        <text class="l-tip">点按查看详情</text>
      </div>
      <div class="lcard" onclick="cardTap1">
        <text class="l-name">{{l2n}}</text>
        <text class="l-dev">{{l2d}}</text>
        <text class="l-pts">{{l2p}}</text>
        <text class="l-tip">点按查看详情</text>
      </div>
      <div class="lcard" onclick="cardTap2">
        <text class="l-name">{{l3n}}</text>
        <text class="l-dev">{{l3d}}</text>
        <text class="l-pts">{{l3p}}</text>
        <text class="l-tip">点按查看详情</text>
      </div>
      <div class="lcard" onclick="cardTap3">
        <text class="l-name">{{l4n}}</text>
        <text class="l-dev">{{l4d}}</text>
        <text class="l-pts">{{l4p}}</text>
        <text class="l-tip">点按查看详情</text>
      </div>
      <div class="lcard" onclick="cardTap4">
        <text class="l-name">{{l5n}}</text>
        <text class="l-dev">{{l5d}}</text>
        <text class="l-pts">{{l5p}}</text>
        <text class="l-tip">点按查看详情</text>
      </div>
      <div class="lcard" onclick="cardTap5">
        <text class="l-name">{{l6n}}</text>
        <text class="l-dev">{{l6d}}</text>
        <text class="l-pts">{{l6p}}</text>
        <text class="l-tip">点按查看详情</text>
      </div>
    </swiper>
    <div class="p-row">
      <div class="p-btn" onclick="listPrev"><text class="p-btn-t">上一页</text></div>
      <div class="p-btn" onclick="listNext"><text class="p-btn-t">下一页</text></div>
    </div>
    <div class="p-btn2" onclick="backToIndex"><text class="p-btn-t2">返回</text></div>
  </div>

  <!-- ── 应用详情（购买 + 构建状态） ── -->
  <div class="panel" if="{{vDetail}}" style="width: {{screenW}};height: {{screenH}};">
    <text class="p-title">{{dName}}</text>
    <text class="d-dev">{{dDev}}</text>
    <text class="d-desc">{{dDesc}}</text>
    <text class="d-meta">{{dMeta}}</text>
    <text class="d-pts">{{dPoints}}</text>
    <text class="s-result">{{dResult}}</text>
    <text class="d-build" if="{{dBuildShow}}">{{dBuild}}</text>
    <div class="p-row">
      <div class="p-btn" onclick="backToIndex"><text class="p-btn-t">返回</text></div>
      <div class="p-btn p-gold" onclick="dGoldTap"><text class="p-btn-t">{{dBtn}}</text></div>
    </div>
  </div>

  <!-- ── 订单列表（3 行 + 翻页） ── -->
  <div class="panel" if="{{vOrd}}" style="width: {{screenW}};height: {{screenH}};">
    <text class="p-title">我的订单</text>
    <div class="rec-card" onclick="ordTap0">
      <text class="rec-name">{{o1n}}</text>
      <text class="rec-meta">{{o1s}}</text>
    </div>
    <div class="rec-card" onclick="ordTap1">
      <text class="rec-name">{{o2n}}</text>
      <text class="rec-meta">{{o2s}}</text>
    </div>
    <div class="rec-card" onclick="ordTap2">
      <text class="rec-name">{{o3n}}</text>
      <text class="rec-meta">{{o3s}}</text>
    </div>
    <text class="p-page">{{orderInfo}}</text>
    <div class="p-row">
      <div class="p-btn" onclick="backToIndex"><text class="p-btn-t">返回</text></div>
      <div class="p-btn" onclick="moreOrders"><text class="p-btn-t">更多订单</text></div>
    </div>
  </div>

  <!-- ── 订单详情（含构建状态） ── -->
  <div class="panel" if="{{vOdD}}" style="width: {{screenW}};height: {{screenH}};">
    <text class="p-title">订单详情</text>
    <text class="o-app">{{odApp}}</text>
    <text class="o-row">{{odVer}} · {{odStatus}}</text>
    <text class="o-row">支付：{{odPay}} · {{odSign}}</text>
    <text class="o-row">设备：{{odDevice}}</text>
    <text class="o-row2">单号 {{odNo}}</text>
    <text class="o-row2">创建于 {{odCreated}}</text>
    <text class="d-build" if="{{odBuildShow}}">{{odBuild}}</text>
    <div class="p-row">
      <div class="p-btn" onclick="showOrdList"><text class="p-btn-t">返回</text></div>
      <div class="p-btn" onclick="ordBuildTap"><text class="p-btn-t">{{odBuildBtn}}</text></div>
    </div>
  </div>
</stack>
