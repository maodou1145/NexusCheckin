<!--
  主页面：竖向 swiper 六屏 + **固定壁纸**（不联网拉取）+ 屏内按钮
  （屏2/3/4/5/6/7/8：每日一句 / 每日诗词 / 历史上的今天 / 每日英语 / 每日简报 / 每日壁纸 / 每日黄历，
    均支持「查看详情 / 点条目」进入页内详情视图看完整版）

  ⚠️ 架构说明（每条都有技能库实证，改前先读）

  1) 【根元素用 stack 而非 div】为了做「壁纸铺底 + 遮罩 + 内容在上」的层叠效果。
     技能库原文：`stack` 的**子组件默认绝对层叠** —— 这是绕过 lite「无 position」的官方手段。
     lite 不支持 z-index，靠**声明顺序**决定层级：先写的在下。

  2) 【壁纸固定，不联网】
     圆表 466×466、方表 408×480 —— 尺寸**不在 HML 里写死**，而是由 JS 用 `@system.device`
     读窗口尺寸后算出来，绑到 `screenW / screenH / swiperW / swiperH / swiperTop / pagebarLeft`。
     ⚠️ 这些变量的值**自带单位**（如 '466px'），HML 里整串替换。
        绝不能把单位写在花括号外面（即「变量 + px」那种拼法）——
        技能库实证：字符串内嵌花括号会真机渲染异常（黑屏隐患）。

  3) 【按钮在 swiper 屏内，随屏滑动；事件必须用裸名 onclick】
     ⚠️ 2026-09-24 实测（HarmonyOS 6.1 wearable 模拟器 / API 24，uitest 注入验证）：
         · `onclick`（裸名）→ 事件**注册成功**，布局树 dumpLayout 显示 click=true，注入点击生效
         · 带 grab 前缀 / on 前缀 → **完全没注册**，click=false，点了毫无反应
     → 本页两路并用：
        ① 每个按钮自己绑 `onclick`（正常时走这条）
        ② swiper 上绑 `onclick="onScreenTap"`（被吞时按 curIdx 执行该屏主操作）
       两条路接同一批动作函数，函数内有 busy 锁防重复触发。

     🔴 【事件前缀必须用裸名 onclick / onchange，不能用带前缀的写法（grab 前缀 / on 前缀】
        2026-09-24 在 HarmonyOS 6.1 wearable 模拟器（API 24）实测：
          · `onclick`（裸名）→ 事件注册成功，布局树 click=true
          · 带 grab 前缀 / on 前缀的写法 → **完全没注册**，布局树 click=false，点了没反应
        证据：uitest dumpLayout 里只有 swiper（绑 onclick）是 click=true；
              用 uitest uiInput click 注入点击，swiper 的 onScreenTap 生效（列表变「加载中…」），
              而同一位置的 pill 按钮（绑带前缀写法）无任何反应。
        → 全工程统一裸名：onclick / onlongpress / onswipe / ontouchstart / ontouchmove / ontouchend / onchange

  4) 【swiper 的 index 绑 swiperIdx 而不是 curIdx】
     swiperIdx 恒为 0（只在初始化时生效），滑动时 onSwiperChange 不回写它
     → 避免 index 与滑动互相打架（回声）。

  5) 【零 list】swiper 内不能含 list（官方父子结构约束，违反则整页不渲染）。

  6) 【零正则】JS 里不能出现正则字面量（JerryScript 不支持 → 整页黑屏）。
-->
<stack class="root">

  <!-- ① 背景层：每日必应壁纸（base64 抓取，见 index.js loadWallpaper）；
       抓取失败时 bgSrc 保持内置图 /common/wall/bing.png 兜底 -->
  <image class="bg-img" style="width: {{screenW}};height: {{screenH}};top: 0px;left: 0px;" src="{{bgSrc}}"></image>
  <!-- ② 压暗遮罩，保证前景文字可读 -->
  <div class="bg-mask" style="width: {{screenW}};height: {{screenH}};top: 0px;left: 0px;"></div>

  <!-- ③ 页码（屏外，兼作「页面是否渲染成功」的探针；left 按屏宽居中） -->
  <text class="pagebar" style="left: {{pagebarLeft}};">{{pageText}}</text>

  <!-- ④ 内容区：竖向 swiper，按钮在屏内随屏滑动。
       ⚠️ 表冠翻屏必须用 ref="mainswiper"（$refs 按 ref 属性注册，不认 id！）——
       之前只写 id 导致 $refs.mainswiper undefined、表冠静默失效 -->
  <swiper
    id="mainswiper"
    ref="mainswiper"
    class="swiper"
    style="width: {{swiperW}};height: {{swiperH}};top: {{swiperTop}};left: 0px;background-color: transparent;"
    index="{{swiperIdx}}"
    vertical="true"
    loop="false"
    indicator="false"
    onchange="onSwiperChange"
    onclick="onScreenTap">

    <!-- 1/8 每日签到 + 幸运大转盘 -->
    <div class="screen" style="width: {{swiperW}};height: {{swiperH}};">
      <!-- 头像 + 问候语（未登录用默认头像、名字显示「用户」） -->
      <div class="hello">
        <image class="avatar" src="{{avatarSrc}}"></image>
        <text class="hello-t">{{greetText}}</text>
      </div>
      <text class="s-title">每日签到</text>
      <text class="s-info">{{checkinInfo}}</text>
      <text class="s-result">{{checkinResult}}</text>
      <div class="pill pill-green" onclick="doCheckin">
        <text class="pill-t">{{checkinBtn}}</text>
      </div>
      <div class="sep"></div>
      <text class="s-sub">幸运大转盘</text>
      <text class="s-info">{{spinInfo}}</text>
      <text class="s-result">{{spinResult}}</text>
      <div class="pill pill-gold" onclick="doSpin">
        <text class="pill-t">{{spinBtn}}</text>
      </div>
    </div>

    <!-- 2/8 每日一句（页内双视图：单句 ⇄ 详情；两个面板都在本屏内部，swiper 子节点数恒定） -->
    <div class="screen" style="width: {{swiperW}};height: {{swiperH}};">
      <div class="hist-panel" if="{{quoteList}}" style="width: {{swiperW}};height: {{swiperH}};">
        <text class="s-title">每日一句</text>
        <text class="quote">{{quoteText}}</text>
        <text class="s-from">{{quoteFrom}}</text>
        <div class="pill pill-blue" onclick="openQuoteDetail">
          <text class="pill-t">查看详情</text>
        </div>
        <div class="pill pill-blue" onclick="nextQuote">
          <text class="pill-t">换一句</text>
        </div>
      </div>

      <div class="hist-panel" if="{{quoteShow}}" style="width: {{swiperW}};height: {{swiperH}};">
        <text class="s-title">名句详情</text>
        <text class="hd-desc">{{qdText}}</text>
        <text class="s-info">{{qdKind}}</text>
        <text class="s-from">出处：{{qdFrom}}</text>
        <text class="s-result">作者：{{qdAuthor}}</text>
        <div class="pill pill-blue" onclick="quoteBack">
          <text class="pill-t">返回</text>
        </div>
      </div>
    </div>

    <!-- 3/8 每日诗词（今日诗词 API，页内双视图：单句 ⇄ 详情） -->
    <div class="screen" style="width: {{swiperW}};height: {{swiperH}};">
      <div class="hist-panel" if="{{poemList}}" style="width: {{swiperW}};height: {{swiperH}};">
        <text class="s-title">每日诗词</text>
        <text class="quote">{{poemText}}</text>
        <text class="s-from">{{poemFrom}}</text>
        <div class="pill pill-blue" onclick="openPoemDetail">
          <text class="pill-t">查看详情</text>
        </div>
        <div class="pill pill-blue" onclick="nextPoem">
          <text class="pill-t">换一首</text>
        </div>
      </div>

      <div class="hist-panel" if="{{poemShow}}" style="width: {{swiperW}};height: {{swiperH}};">
        <text class="s-title">诗词详情</text>
        <text class="poem-desc">{{pdText}}</text>
        <text class="s-info">{{pdKind}}</text>
        <text class="s-from">《{{pdSource}}》 · {{pdAuthor}}</text>
        <div class="pill pill-blue" onclick="poemBack">
          <text class="pill-t">返回</text>
        </div>
      </div>
    </div>

    <!-- 4/8 历史上的今天（页内双视图：列表 ⇄ 详情。
         ⚠️ 两个 if 面板都包在这一屏内部 —— swiper 的直接子节点数必须恒定，
             在子屏上做 if 会让子节点数变化，翻页状态会乱） -->
    <div class="screen" style="width: {{swiperW}};height: {{swiperH}};">
      <div class="hist-panel" if="{{histList}}" style="width: {{swiperW}};height: {{swiperH}};">
        <text class="s-title">历史上的今天</text>
        <div class="rec-card" onclick="histTap0">
          <text class="rec-name">{{h1t}}</text>
          <text class="rec-meta">{{h1y}}</text>
        </div>
        <div class="rec-card" onclick="histTap1">
          <text class="rec-name">{{h2t}}</text>
          <text class="rec-meta">{{h2y}}</text>
        </div>
        <div class="rec-card" onclick="histTap2">
          <text class="rec-name">{{h3t}}</text>
          <text class="rec-meta">{{h3y}}</text>
        </div>
        <text class="my-hint">{{histInfo}}</text>
        <div class="pill pill-blue" onclick="nextHist">
          <text class="pill-t">换一批</text>
        </div>
      </div>

      <!-- 历史详情（完整描述，完整标题不截断） -->
      <div class="hist-panel" if="{{histShow}}" style="width: {{swiperW}};height: {{swiperH}};">
        <text class="s-title">历史详情</text>
        <text class="s-info">{{hdTitle}}</text>
        <text class="s-from">{{hdMeta}}</text>
        <text class="hd-desc">{{hdDesc}}</text>
        <div class="pill pill-blue" onclick="histBack">
          <text class="pill-t">返回列表</text>
        </div>
      </div>
    </div>

    <!-- 5/8 每日英语（内置词库按日期轮换，零请求） -->
    <div class="screen" style="width: {{swiperW}};height: {{swiperH}};">
      <div class="hist-panel" if="{{wordList}}" style="width: {{swiperW}};height: {{swiperH}};">
        <text class="s-title">每日英语</text>
        <text class="quote">{{wordText}}</text>
        <text class="s-from">{{wordPhon}}</text>
        <text class="s-info">{{wordMean}}</text>
        <text class="s-result">{{wordEx}}</text>
        <div class="pill pill-blue" onclick="openWordDetail">
          <text class="pill-t">查看详情</text>
        </div>
        <div class="pill pill-blue" onclick="nextWord">
          <text class="pill-t">换一个</text>
        </div>
      </div>

      <div class="hist-panel" if="{{wordShow}}" style="width: {{swiperW}};height: {{swiperH}};">
        <text class="s-title">单词详情</text>
        <text class="word-big">{{wordText}}</text>
        <text class="s-from">{{wordPhon}}</text>
        <text class="wd-mean">{{wordMeanFull}}</text>
        <text class="wd-ex">{{wdExAll}}</text>
        <div class="pill pill-blue" onclick="wordBack">
          <text class="pill-t">返回</text>
        </div>
      </div>
    </div>

    <!-- 6/8 每日简报（60s 读懂世界：要闻 3 条一组 + 寄语 + 农历；页内双视图） -->
    <div class="screen" style="width: {{swiperW}};height: {{swiperH}};">
      <div class="hist-panel" if="{{briefList}}" style="width: {{swiperW}};height: {{swiperH}};">
        <text class="s-title">每日简报</text>
        <text class="s-info">{{briefDate}} · {{briefLunar}}</text>
        <text class="brief-tip">{{briefTip}}</text>
        <div class="rec-card" onclick="briefTap0">
          <text class="rec-name">{{b1t}}</text>
        </div>
        <div class="rec-card" onclick="briefTap1">
          <text class="rec-name">{{b2t}}</text>
        </div>
        <div class="rec-card" onclick="briefTap2">
          <text class="rec-name">{{b3t}}</text>
        </div>
        <text class="my-hint">{{briefInfo}}</text>
        <div class="pill pill-blue" onclick="nextBrief">
          <text class="pill-t">换一批</text>
        </div>
      </div>

      <div class="hist-panel" if="{{briefShow}}" style="width: {{swiperW}};height: {{swiperH}};">
        <text class="s-title">要闻</text>
        <text class="hd-desc">{{bdText}}</text>
        <text class="s-from">{{bdMeta}}</text>
        <div class="pill pill-blue" onclick="briefBack">
          <text class="pill-t">返回列表</text>
        </div>
      </div>
    </div>

    <!-- 7/8 每日壁纸（显示当前壁纸出处，可手动往前翻最近 8 天） -->
    <div class="screen" style="width: {{swiperW}};height: {{swiperH}};">
      <text class="s-title">每日壁纸</text>
      <text class="s-info">当前：{{wallLabel}}</text>
      <text class="hd-desc">{{wallCopy}}</text>
      <text class="img-diag">{{imgDiag}}</text>
      <div class="pill pill-blue" onclick="nextWall">
        <text class="pill-t">换一张壁纸</text>
      </div>
    </div>

    <!-- 8/10 每日黄历（主页 ⇄ 详情；页内双视图，lite 路由会重建页面所以不开新页）
         数据：60s API /v2/lunar —— 公历/农历/干支/生肖/纳音/宜忌/节气/节日/月相/星座/运势 -->
    <div class="screen" style="width: {{swiperW}};height: {{swiperH}};">

      <div class="cal-panel" if="{{calMain}}" style="width: {{swiperW}};height: {{swiperH}};">
        <text class="s-title">今日黄历</text>
        <text class="cal-date">{{calDate}}</text>
        <text class="cal-lunar">{{calLunar}}</text>
        <text class="cal-cycle">{{calCycle}}</text>
        <text class="cal-fest">{{calFest}}</text>
        <text class="cal-good">{{calGood}}</text>
        <text class="cal-bad">{{calBad}}</text>
        <div class="pill pill-blue" onclick="openCalDetail">
          <text class="pill-t">查看详情</text>
        </div>
      </div>

      <div class="cal-panel" if="{{calDetail}}" style="width: {{swiperW}};height: {{swiperH}};">
        <text class="s-title">黄历详情 {{calPageNo}}</text>
        <text class="cal-page">{{calPage}}</text>
        <div class="pill pill-blue" onclick="nextCalPage">
          <text class="pill-t">下一页</text>
        </div>
        <div class="pill pill-blue" onclick="calBack">
          <text class="pill-t">返回主页</text>
        </div>
      </div>

    </div>

    <!-- 9/10 我的（5 行 div，不用 list） -->
    <div class="screen" style="width: {{swiperW}};height: {{swiperH}};">
      <text class="s-title">我的</text>
      <div class="my-row">
        <text class="my-k">昵称</text>
        <text class="my-v">{{myNick}}</text>
      </div>
      <div class="my-row">
        <text class="my-k">等级</text>
        <text class="my-v">{{myLevel}}</text>
      </div>
      <div class="my-row">
        <text class="my-k">经验</text>
        <text class="my-v">{{myExp}}</text>
      </div>
      <div class="my-row">
        <text class="my-k">积分</text>
        <text class="my-v">{{myPoints}}</text>
      </div>
      <div class="my-row">
        <text class="my-k">Token</text>
        <text class="my-v">{{myToken}}</text>
      </div>
      <!-- B 方案：自研键盘直接输入（A 方案打包注入仍可用，见 tools/pack-for-user） -->
      <div class="pill pill-blue" onclick="openTokenKb">
        <text class="pill-t">输入 Token</text>
      </div>
      <text class="my-hint">或私聊发作者定制（免输入）</text>
    </div>

    <!-- 10/10 关于（数据来源 + 免责声明 / 侵权删除） -->
    <div class="screen" style="width: {{swiperW}};height: {{swiperH}};">
      <text class="s-title">关于</text>
      <text class="about-desc">{{aboutText}}</text>
    </div>

  </swiper>

  <!-- ── 全局轻提示（位置由 JS 按设备算） ── -->
  <text class="toast" if="{{toastShow}}" style="top: {{toastTop}};width: {{toastW}};">{{toastText}}</text>

</stack>
