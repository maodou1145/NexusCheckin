[["diligent","/dɪlɪdʒənt/","adj.","勤奋的，用功的","He is a diligent student.","他是个勤奋的学生。"],["serene","/səriːn/","adj.","平静的，安详的","The lake is serene at dawn.","黎明时湖水一片宁静。"],["curious","/kjʊəriəs/","adj.","好奇的","Children are curious about everything.","孩子们对一切都好奇。"],["gentle","/dʒentl/","adj.","温和的，轻柔的","She gave a gentle smile.","她露出温和的微笑。"],["brave","/breɪv/","adj.","勇敢的","Be brave when facing difficulties.","面对困难要勇敢。"],["honest","/ɒnɪst/","adj.","诚实的","An honest answer wins trust.","诚实的回答赢得信任。"],["patient","/peɪʃnt/","adj.","有耐心的","Please be patient with me.","请对我耐心一点。"],["humble","/hʌmbl/","adj.","谦逊的","Stay humble after success.","成功后保持谦逊。"],["sincere","/sɪnsɪə/","adj.","真诚的","He gave sincere advice.","他给出了真诚的建议。"],["grateful","/ɡreɪtfl/","adj.","感激的","I am grateful for your help.","我很感激你的帮助。"],["optimist","/ɒptɪmɪst/","n.","乐观的人","An optimist sees the bright side.","乐观者看到光明的一面。"],["courage","/kʌrɪdʒ/","n.","勇气","Courage is not without fear.","勇气并非毫无恐惧。"],["wisdom","/wɪzdəm/","n.","智慧","Wisdom grows with experience.","智慧随经验增长。"],["freedom","/friːdəm/","n.","自由","Freedom comes with duty.","自由伴随着责任。"],["friendship","/frendʃɪp/","n.","友谊","Friendship needs honesty.","友谊需要诚实。"],["journey","/dʒɜːni/","n.","旅程","Life is a long journey.","人生是一场漫长的旅程。"],["memory","/meməri/","n.","记忆，回忆","The song brought back memories.","这首歌唤起了回忆。"],["silence","/saɪləns/","n.","寂静，沉默","Silence can be an answer.","沉默也可以是一种回答。"],["harvest","/hɑːvɪst/","n.","收获","Autumn is the harvest season.","秋天是收获的季节。"],["blossom","/blɒsəm/","n.","花，开花","Cherry blossoms bloom in spring.","樱花在春天绽放。"],["explore","/ɪksplɔː/","v.","探索","We explore the old town on foot.","我们徒步探索老城。"],["imagine","/ɪmædʒɪn/","v.","想象","Imagine a world without war.","想象一个没有战争的世界。"],["breathe","/briːð/","v.","呼吸","Breathe deeply and relax.","深呼吸，放松下来。"],["shine","/ʃaɪn/","v.","发光，闪耀","Stars shine brightest at night.","星星在夜里最亮。"],["cherish","/tʃerɪʃ/","v.","珍惜","Cherish the time with family.","珍惜与家人相处的时光。"],["persist","/pəsɪst/","v.","坚持","Persist and you will succeed.","坚持下去就会成功。"],["forgive","/fəɡɪv/","v.","原谅","Forgive and move on.","原谅，然后向前走。"],["discover","/dɪskʌvə/","v.","发现","Discover new paths every day.","每天发现新的路。"],["appreciate","/əpriːʃieɪt/","v.","感激，欣赏","I appreciate your kindness.","我感激你的善意。"],["consider","/kənsɪdə/","v.","考虑","Consider others before yourself.","先为别人着想。"],["gather","/ɡæðə/","v.","聚集，收集","We gather flowers in the field.","我们在田野里采花。"],["whisper","/wɪspə/","v.","低语","The wind whispers in the trees.","风在林间低语。"],["wander","/wɒndə/","v.","漫步，徘徊","He wanders around the old streets.","他在老街间徘徊。"],["sparkle","/spɑːkl/","v.","闪耀","Her eyes sparkle with joy.","她的双眼闪着喜悦。"],["radiant","/reɪdiənt/","adj.","光芒四射的","She looks radiant today.","她今天容光焕发。"],["cozy","/kəʊzi/","adj.","温暖舒适的","The room feels cozy in winter.","冬天里房间很温馨。"],["lively","/laɪvli/","adj.","活泼的","The market is lively in the morning.","清晨的市场很热闹。"],["gentleness","/dʒentlnəs/","n.","温柔","Gentleness is a kind of strength.","温柔也是一种力量。"],["moment","/məʊmənt/","n.","时刻，瞬间","Enjoy every moment of today.","享受今天的每一刻。"],["hopeful","/həʊpfl/","adj.","充满希望的","Stay hopeful about tomorrow.","对明天保持希望。"],["admire","/ədˈmaɪə/","v.","钦佩，欣赏","I admire her courage.","我钦佩她的勇气。"],["adventure","/ədˈventʃə/","n.","冒险","Life is an adventure.","人生是一场冒险。"],["angel","/ˈeɪndʒəl/","n.","天使","She is kind as an angel.","她像天使一样善良。"],["balance","/ˈbæləns/","n.","平衡","Keep a work-life balance.","保持工作与生活的平衡。"],["breeze","/briːz/","n.","微风","A breeze passed through the trees.","微风吹过树林。"],["calm","/kɑːm/","adj.","平静的","Stay calm under pressure.","压力下保持冷静。"],["candle","/ˈkændl/","n.","蜡烛","The candle light is warm.","烛光很温暖。"],["celebrate","/ˈselɪbreɪt/","v.","庆祝","We celebrate the new year together.","我们一起庆祝新年。"],["challenge","/ˈtʃælɪndʒ/","n.","挑战","Every challenge makes you stronger.","每个挑战都让你更强。"],["chance","/tʃɑːns/","n.","机会","Give it one more chance.","再给它一次机会。"],["character","/ˈkærəktə/","n.","品格","Character matters more than looks.","品格比外表更重要。"],["comfort","/ˈkʌmfət/","n.","安慰，舒适","Her words gave me comfort.","她的话给了我安慰。"],["confidence","/ˈkɒnfɪdəns/","n.","信心","Confidence comes from practice.","信心来自练习。"],["connect","/kəˈnekt/","v.","连接","Music connects our hearts.","音乐连接我们的心。"],["create","/kriˈeɪt/","v.","创造","Everyone can create beauty.","每个人都能创造美。"],["dance","/dɑːns/","v.","跳舞","Leaves dance in the wind.","树叶在风中起舞。"],["dawn","/dɔːn/","n.","黎明","Work hard before dawn breaks.","黎明破晓前努力。"],["delight","/dɪˈlaɪt/","n.","快乐","The kids screamed with delight.","孩子们开心地欢呼。"],["dream","/driːm/","n.","梦想","Follow your own dream.","追随你自己的梦想。"],["embrace","/ɪmˈbreɪs/","v.","拥抱","Embrace every change in life.","拥抱生活中的每次改变。"],["energy","/ˈenədʒi/","n.","活力，能量","Morning run gives me energy.","晨跑给我能量。"],["enjoy","/ɪnˈdʒɔɪ/","v.","享受","Enjoy the little things.","享受小事。"],["faith","/feɪθ/","n.","信念","Faith moves mountains.","信念能移山。"],["favor","/ˈfeɪvə/","n.","恩惠，好感","May I ask a favor?","能帮个忙吗？"],["feather","/ˈfeðə/","n.","羽毛","Light as a feather.","轻如羽毛。"],["festival","/ˈfestɪvl/","n.","节日","The festival brings families home.","节日让家人回家。"],["firefly","/ˈfaɪəflaɪ/","n.","萤火虫","Fireflies glow in the dark.","萤火虫在黑暗中发光。"],["flourish","/ˈflʌrɪʃ/","v.","繁荣，茁壮","Flowers flourish after rain.","雨后花开得更盛。"],["giggle","/ˈɡɪɡl/","v.","咯咯笑","The baby giggles happily.","婴儿开心地咯咯笑。"],["glance","/ɡlɑːns/","n.","一瞥","One glance was enough.","一眼就够了。"],["glow","/ɡləʊ/","v.","发光","The sky glows at sunset.","日落时天空发光。"],["gratitude","/ˈɡrætɪtjuːd/","n.","感恩","Show gratitude every day.","每天心怀感恩。"],["harmony","/ˈhɑːməni/","n.","和谐","We live in harmony with nature.","我们与自然和谐相处。"],["heal","/hiːl/","v.","治愈","Time heals every wound.","时间治愈一切。"],["heaven","/ˈhevn/","n.","天堂","The view is heaven on earth.","这景色美如天堂。"],["honey","/ˈhʌni/","n.","蜂蜜","Bees make sweet honey.","蜜蜂酿出甜蜂蜜。"],["horizon","/həˈraɪzn/","n.","地平线","The sun rises above the horizon.","太阳升出地平线。"],["hug","/hʌɡ/","n.","拥抱","A warm hug says a lot.","一个温暖的拥抱胜过千言。"],["inspire","/ɪnˈspaɪə/","v.","激励","Great books inspire us.","好书激励我们。"],["kind","/kaɪnd/","adj.","善良的","Be kind to strangers.","对陌生人友善。"],["laugh","/lɑːf/","v.","笑","Laugh often, live long.","常笑者长寿。"],["liberty","/ˈlɪbəti/","n.","自由","They fought for liberty.","他们为自由而战。"],["light","/laɪt/","n.","光","Light wins over darkness.","光明战胜黑暗。"],["listen","/ˈlɪsn/","v.","倾听","Listen more, speak less.","多倾听，少说话。"],["lovely","/ˈlʌvli/","adj.","可爱的","What a lovely evening.","多么迷人的夜晚。"],["loyal","/ˈlɔɪəl/","adj.","忠诚的","A loyal friend is rare.","忠诚的朋友难得。"],["lucky","/ˈlʌki/","adj.","幸运的","I feel lucky today.","今天我感觉很幸运。"],["magic","/ˈmædʒɪk/","n.","魔法","Music is pure magic.","音乐是纯粹的魔法。"],["melody","/ˈmelədi/","n.","旋律","The melody stays in my mind.","旋律萦绕在心。"],["miracle","/ˈmɪrəkl/","n.","奇迹","Every sunrise is a miracle.","每次日出都是奇迹。"],["nature","/ˈneɪtʃə/","n.","自然","Nature is the best teacher.","自然是最好的老师。"],["nurture","/ˈnɜːtʃə/","v.","养育","Nurture your dreams daily.","每天浇灌你的梦想。"],["peace","/piːs/","n.","和平，安宁","Peace begins with a smile.","和平始于微笑。"],["petal","/ˈpetl/","n.","花瓣","Petals fall like snow.","花瓣如雪飘落。"],["praise","/preɪz/","n.","赞美","Praise warms the heart.","赞美温暖人心。"],["precious","/ˈpreʃəs/","adj.","珍贵的","Time is the most precious gift.","时间是最珍贵的礼物。"],["promise","/ˈprɒmɪs/","n.","承诺","Keep your promise always.","永远遵守承诺。"],["quiet","/ˈkwaɪət/","adj.","安静的","The night is quiet and clear.","夜晚安静清澈。"],["refresh","/rɪˈfreʃ/","v.","使焕新","Rain refreshes the earth.","雨水让大地焕新。"],["relax","/rɪˈlæks/","v.","放松","Relax and take it slow.","放松，慢慢来。"],["rescue","/ˈreskjuː/","v.","拯救","Firemen rescue the cat.","消防员救下小猫。"],["respect","/rɪˈspekt/","v.","尊重","Respect different opinions.","尊重不同的意见。"],["ribbon","/ˈrɪbən/","n.","丝带","She ties a red ribbon.","她系上红丝带。"],["romance","/rəʊˈmæns/","n.","浪漫","Stars add romance to the night.","星星为夜添浪漫。"],["scent","/sent/","n.","香气","The scent of flowers fills the room.","花香满屋。"],["shelter","/ˈʃeltə/","n.","庇护","The tree is our shelter.","大树是我们的庇护。"],["smile","/smaɪl/","v.","微笑","Smile at the world.","对世界微笑。"],["soft","/sɒft/","adj.","柔软的","The pillow is soft and cool.","枕头柔软凉爽。"],["solace","/ˈsɒləs/","n.","慰藉","Music gives me solace.","音乐给我慰藉。"],["spring","/sprɪŋ/","n.","春天","Spring wakes everything up.","春天唤醒万物。"],["strength","/streŋθ/","n.","力量","Hope is quiet strength.","希望是安静的力量。"],["sunrise","/ˈsʌnraɪz/","n.","日出","We watched the sunrise together.","我们一起看日出。"],["sunset","/ˈsʌnset/","n.","日落","The sunset painted the sky red.","落日把天空染红。"],["tender","/ˈtendə/","adj.","温柔的","The night breeze is tender.","夜风温柔。"],["thrill","/θrɪl/","n.","激动","The ride gave me a thrill.","过山车让我兴奋。"],["together","/təˈɡeðə/","adv.","一起","Together we are stronger.","团结让我们更强。"],["treasure","/ˈtreʒə/","v.","珍视","I treasure this memory.","我珍视这段回忆。"],["trust","/trʌst/","v.","信任","Trust takes years to build.","信任需要多年建立。"],["valley","/ˈvæli/","n.","山谷","The valley echoes with birdsong.","山谷回荡鸟鸣。"],["wonder","/ˈwʌndə/","n.","奇迹，惊叹","Children see wonder everywhere.","孩子们处处看见奇迹。"]]